# ==========================================
# PRODUKSI: WAJIB diubah sebelum go-live
#   APP_ENV=production
#   APP_DEBUG=false          (true membocorkan stack trace, query, & nilai .env)
#   APP_URL=https://domain-produksi
#   CORS_ALLOWED_ORIGINS=https://domain-frontend   (lihat bagian keamanan di bawah)
# ==========================================
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Origin browser yang boleh memanggil API (dipisah koma). Kosong = default alamat
# frontend lokal. Jangan pakai '*' di produksi.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Password akun seeder (wajib diganti sebelum seeding produksi)
ADMIN_PASSWORD=
ADMIN_TU_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ==========================================
# CHATBOT AI CONFIGURATION
# ==========================================
CHATBOT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Optional OpenAI / Groq / OpenRouter
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Batas pemakaian harian API AI (per IP dan total seluruh situs)
CHATBOT_DAILY_LIMIT_PER_IP=50
CHATBOT_DAILY_LIMIT_TOTAL=1000
CHATBOT_MAX_HISTORY=10
MAJOR_QUIZ_DAILY_LIMIT_PER_IP=3
MAJOR_QUIZ_DAILY_LIMIT_TOTAL=300


# IP server Next.js (dipisah koma) yang dibebaskan dari batas 300 request/menit endpoint publik
FRONTEND_SERVER_IPS=127.0.0.1,::1

# Web Push layanan alumni. Buat sekali: php artisan tinker -> Minishlink\WebPush\VAPID::createVapidKeys()
# Di Windows set OPENSSL_CONF ke openssl.cnf bawaan PHP sebelum menjalankan server dan queue worker.
VAPID_SUBJECT=mailto:smkn2mr@gmail.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Bank Mini & Pembayaran SPP. Iuran Rp 225.000/bulan = Rp 175.000 SPP + Rp 50.000 tabungan.
BANK_MINI_NOMINAL_SPP=175000
BANK_MINI_NOMINAL_TABUNGAN=50000
BANK_MINI_TANGGAL_JATUH_TEMPO=10
# Tripay (sama dengan api-getskill). Sandbox: https://tripay.co.id/api-sandbox/  Produksi: https://tripay.co.id/api/
# Callback URL di dashboard Tripay: {APP_URL}/api/bank-mini/webhook
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_API_URL=https://tripay.co.id/api-sandbox/
TRIPAY_CALLBACK_TOKEN=
BANK_MINI_GATEWAY_EXPIRY_HOURS=24
# Tripay mewajibkan email pelanggan; siswa belum punya email, jadi dipakai email Bank Mini/TU.
BANK_MINI_CUSTOMER_EMAIL=tu@smkn2mojokerto.sch.id

# Akun petugas loket Bank Mini (terpisah dari Tata Usaha)
BANK_MINI_PETUGAS_PASSWORD=
